<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="پکیج اپ منبع (جدول مرجع):" />
        <EditText
            android:id="@+id/etSourcePkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثلاً com.example.source" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="پکیج اپ مقصد (اپلیکیشن معاملات):" />
        <EditText
            android:id="@+id/etTargetPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="مثلاً com.example.target" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حداقل تعداد رقم عدد" />
                <EditText
                    android:id="@+id/etMinDigits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="فاصله بین کلیک‌ها (ms)" />
                <EditText
                    android:id="@+id/etClickDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="حداکثر تعداد کلیک برای هر فیلد" />
        <EditText
            android:id="@+id/etMaxClicks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="تنظیمات فیلدها (JSON) — با دکمه «پیش‌نمایش» ایندکس‌های درست را پیدا و اینجا اصلاح کنید:" />
        <EditText
            android:id="@+id/etFieldMapJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="8"
            android:gravity="top|start"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="کلمات هشدار پاپ‌آپ معامله (با کاما جدا کنید):" />
        <EditText
            android:id="@+id/etPauseKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top|start"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="مقادیر فعلی واقعی مقصد (کالیبراسیون — چون مقدار مقصد خونده نمی‌شه، اینجا با چشم خودتون وارد کنید؛ کلیدها باید دقیقاً همون «name» تو تنظیمات فیلدها باشن):" />
        <EditText
            android:id="@+id/etTrackedValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:hint="{&quot;نقد فردا - خرید از ما&quot;:102790000, ...}" />

        <Switch
            android:id="@+id/switchAutoSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="همگام‌سازی خودکار فعال باشد" />

        <Button
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="باز کردن تنظیمات Accessibility" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ذخیره تنظیمات" />

        <Button
            android:id="@+id/btnRefreshPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="پیش‌نمایش اعداد شناسایی‌شده" />

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="همگام‌سازی دستی (یک بار)" />

        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="" />

    </LinearLayout>
</ScrollView>